<Page x:Class="EquipmentForRent.Pages.ProfileClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль клиента">

    <Grid Margin="20">
        <!-- ScrollViewer для прокрутки контента -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <Grid>
                <!-- Кнопка "Назад" в левом верхнем углу -->
                <Button Click="BackButton_Click" Padding="15,10" Height="50" Width="125" Margin="0,0,0,20" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <!-- Контент страницы -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
                    <!-- Аватар клиента с контекстным меню -->
                    <Image x:Name="AvatarImage" Width="120" Height="120" Stretch="UniformToFill"
                           HorizontalAlignment="Center" Margin="0,0,0,20"
                           ToolTip="Нажмите, чтобы изменить или удалить аватарку">
                        <Image.Clip>
                            <!-- Используем EllipseGeometry для круглой аватарки -->
                            <EllipseGeometry RadiusX="60" RadiusY="60" Center="60,60"/>
                        </Image.Clip>

                        <Image.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Изменить аватарку" Click="ChangeAvatar_Click"/>
                                <MenuItem Header="Удалить аватарку" Click="DeleteAvatar_Click"/>
                            </ContextMenu>
                        </Image.ContextMenu>
                    </Image>

                    <!-- Имя клиента -->
                    <TextBlock x:Name="ClientName" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>

                    <!-- Email клиента -->
                    <TextBlock x:Name="ClientEmail" FontSize="16" Foreground="Gray"
                               HorizontalAlignment="Center" Margin="0,10,0,20"/>

                    <!-- Контейнер для кнопок -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <!-- Кнопка редактирования профиля -->
                        <Button Click="EditProfile_Click" Padding="15,10" Height="50" Width="247" Content="Редактировать профиль"/>
                    </StackPanel>

                    <!-- Дополнительная информация -->
                    <TextBlock Text="Дополнительная информация" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,20,0,10"/>

                    <!-- Пример вывода другого контента -->
                    <TextBlock Text="Здесь будет дополнительная информация о клиенте" 
                               HorizontalAlignment="Center" Margin="0,10,0,20" Foreground="Black" FontSize="14"/>
                </StackPanel>
            </Grid>

        </ScrollViewer>
    </Grid>
</Page>

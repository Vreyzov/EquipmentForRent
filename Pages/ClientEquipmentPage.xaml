<Page x:Class="EquipmentForRent.Pages.ClientEquipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Client Equipment Page">

    <Grid>
        <!-- Заголовок страницы -->
        <TextBlock Text="Доступное оборудование" FontSize="24" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10"/>

        <!-- Панель для поиска и фильтрации по горизонтали -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,10,0">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="SearchTextBox" VerticalAlignment="Center" Width="300" Height="30" Margin="5"
                     TextChanged="SearchTextBox_TextChanged"/>
            <TextBlock Text="Мин. Цена:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="MinPriceTextBox" VerticalAlignment="Center" Width="100" Height="30" Margin="5"
                     TextChanged="SearchTextBox_TextChanged"/>
            <TextBlock Text="Макс. Цена:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="MaxPriceTextBox" VerticalAlignment="Center" Width="100" Height="30" Margin="5"
                     TextChanged="SearchTextBox_TextChanged"/>
        </StackPanel>

        <!-- Список оборудования -->
        <ListBox Name="EquipmentListBox" Margin="10,100,10,100">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <!-- Округленное изображение аватарки -->
                        <Border Width="50" Height="50" BorderBrush="Black" BorderThickness="1" CornerRadius="25" Margin="5">
                            <Canvas>
                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" Width="50" Height="50">
                                    <Image.Clip>
                                        <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                                    </Image.Clip>
                                </Image>
                            </Canvas>
                        </Border>

                        <!-- Информация об арендодателе -->
                        <StackPanel VerticalAlignment="Center" Margin="10,0,10,0">
                            <TextBlock Text="{Binding Lessor.FirstName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Lessor.LastName}"/>
                        </StackPanel>

                        <!-- Название оборудования и цена -->
                        <StackPanel VerticalAlignment="Center" Margin="10,0,10,0">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PricePerDay, StringFormat='Цена: {0} р/день'}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопка "Оформить заказ" -->
        <Button Content="Оформить заказ" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="200" Height="50" Margin="0,0,10,10" Click="PlaceOrderButton_Click"/>

        <!-- Кнопка "Назад" -->
        <Button Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="100" Height="50" Margin="10,0,0,10" Click="BackButton_Click"/>
    </Grid>
</Page>

<Page x:Class="EquipmentForRent.Pages.ProfileLessorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль арендодателя"  >

    <Grid Margin="20">
        <!-- ScrollViewer для прокрутки контента -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Кнопка "Назад" -->
                <Button Click="BackButton_Click" Padding="15,10" Height="50" Width="125" 
                        Margin="0,0,0,20" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
                    <!-- Аватар -->
                    <Image x:Name="AvatarImage" Width="120" Height="120" Stretch="UniformToFill"
                           HorizontalAlignment="Center" Margin="0,0,0,20"
                           ToolTip="Нажмите, чтобы изменить или удалить аватарку">
                        <Image.Clip>
                            <EllipseGeometry RadiusX="60" RadiusY="60" Center="60,60"/>
                        </Image.Clip>

                        <Image.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Изменить аватарку" Click="ChangeAvatar_Click"/>
                                <MenuItem Header="Удалить аватарку" Click="DeleteAvatar_Click"/>
                            </ContextMenu>
                        </Image.ContextMenu>
                    </Image>

                    <!-- Данные арендодателя -->
                    <TextBlock x:Name="LessorName" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>

                    <TextBlock x:Name="LessorEmail" FontSize="16" Foreground="Gray"
                               HorizontalAlignment="Center" Margin="0,10,0,20"/>

                    <TextBlock x:Name="LessorRating" FontSize="16" Foreground="DarkOrange"
                               HorizontalAlignment="Center" Margin="0,10,0,20"/>

                    <!-- Кнопка редактирования -->
                    <Button Click="EditProfile_Click" Padding="15,10" Height="50" Width="247"
                            Content="Редактировать профиль" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Заголовок отзывов -->
                    <TextBlock Text="Отзывы" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,20,0,10"/>

                    <!-- Поле с границами для отзывов -->
                    <Border BorderThickness="2" BorderBrush="Gray" CornerRadius="5"
                            Padding="10" Width="350" Height="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ReviewsPanel">
                                <!-- Здесь будут отзывы -->
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

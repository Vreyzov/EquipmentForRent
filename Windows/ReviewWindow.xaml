<Window x:Class="EquipmentForRent.Windows.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оставить отзыв" Height="500" Width="500" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Заголовок -->
        <TextBlock Text="Арендодатель" FontSize="18" FontWeight="Bold" 
                   VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>

        <!-- Аватар и имя арендодателя -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
            <Image x:Name="LessorAvatarImage" Width="80" Height="80" Stretch="UniformToFill"
                   HorizontalAlignment="Center" Margin="0,0,10,0" ClipToBounds="True">
                <Image.Clip>
                    <EllipseGeometry RadiusX="40" RadiusY="40" Center="40,40"/>
                </Image.Clip>
            </Image>
            <TextBlock x:Name="LessorNameTextBlock" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,0,0,0"/>
        </StackPanel>

        <!-- Название оборудования -->
        <TextBlock Text="Оборудование" FontSize="16" FontWeight="Bold" 
                   VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,120,0,0"/>

        <TextBlock x:Name="EquipmentNameTextBlock" FontSize="14" HorizontalAlignment="Center" 
                   VerticalAlignment="Top" Margin="0,150,0,0" TextWrapping="Wrap"/>

        <!-- Оценка аренды -->
        <TextBlock Text="Оцените аренду" FontSize="16" FontWeight="Bold" 
                   VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,200,0,0"/>

        <ComboBox x:Name="RatingComboBox" Width="200" Height="30" 
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,230,0,0">
            <ComboBoxItem Content="1 ★"/>
            <ComboBoxItem Content="2 ★★"/>
            <ComboBoxItem Content="3 ★★★"/>
            <ComboBoxItem Content="4 ★★★★"/>
            <ComboBoxItem Content="5 ★★★★★"/>
        </ComboBox>

        <!-- Поле для ввода отзыва -->
        <TextBox x:Name="ReviewTextBox" Width="300" Height="80" HorizontalAlignment="Center"
                 VerticalAlignment="Top" Margin="0,270,0,0"
                 TextWrapping="Wrap" AcceptsReturn="True"/>

        <!-- Надпись под полем ввода -->
        <TextBlock Text="Оставьте отзыв (необязательно)" Foreground="Gray"
                   FontSize="12" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,370,0,0"/>

        <!-- Кнопки для отправки и отмены -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,400,0,0">
            <Button Content="Отправить" Click="SubmitReview_Click" Width="120" Margin="10"/>
         
        </StackPanel>
    </Grid>
</Window>

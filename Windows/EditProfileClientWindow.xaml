<Window x:Class="EquipmentForRent.Windows.EditProfileClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование профиля" Height="500" Width="600">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Редактирование профиля" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Имя -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Имя:" VerticalAlignment="Center" Width="100"/>
                <TextBox Name="FirstNameTextBox" Width="400" Margin="5"/>
            </StackPanel>

            <!-- Фамилия -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Фамилия:" VerticalAlignment="Center" Width="100"/>
                <TextBox Name="LastNameTextBox" Width="400" Margin="5"/>
            </StackPanel>

            <!-- Электронная почта -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Email:" VerticalAlignment="Center" Width="100"/>
                <TextBox Name="EmailTextBox" Width="400" Margin="5"/>
            </StackPanel>

            <!-- Телефон -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Телефон:" VerticalAlignment="Center" Width="100"/>
                <TextBox Name="PhoneTextBox" Width="400" Margin="5"/>
            </StackPanel>

            <!-- Логин -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Логин:" VerticalAlignment="Center" Width="100"/>
                <TextBox Name="LoginTextBox" Width="400" Margin="5"/>
            </StackPanel>

            <!-- Пароль с глазиком внутри поля -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Пароль:" VerticalAlignment="Center" Width="100"/>

                <Grid Width="400">
                    <!-- Поле для скрытого ввода пароля -->
                    <PasswordBox Name="PasswordBox" Width="400" Margin="0" PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Поле для отображения пароля (по умолчанию скрыто) -->
                    <TextBox Name="PasswordTextBox" Width="400" Margin="0" Visibility="Collapsed"/>

                    <!-- Кнопка-глазик -->
                    <Button Name="ShowPasswordButton" Content="👁️" Width="35" Height="30" 
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="365,0,0,0" Click="ShowPasswordButton_Click"/>
                </Grid>
            </StackPanel>

            <!-- Кнопки Сохранить и Отмена -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,10">
                <Button Name="SaveButton" Content="Сохранить" Width="100" Height="35" Click="SaveButton_Click"/>
                <Button Name="CancelButton" Content="Отмена" Width="100" Height="35" Margin="10,0,0,0" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
